<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/educasst_bg"
        android:scaleType="centerCrop"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/purple_700"
        android:alpha="0.6"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_margin="24dp">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_secondary"
                android:gravity="center_horizontal"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:text="Please Submit the Requirements"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/birth_certificate"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="32dp"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/birth_certificate_image"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/baseline_add_circle_24"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="8dp"
                            android:text="Birth Certification"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="18sp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/valid_id"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="32dp"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/valid_id_image"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/baseline_add_circle_24"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Valid ID"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="18sp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cog_cor"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="32dp"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/cog_cor_image"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/baseline_add_circle_24"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="COG/COR"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="18sp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.cardview.widget.CardView>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_white"
                    android:textColor="@android:color/secondary_text_light"
                    android:text="Submit"
                    android:layout_gravity="end"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="24dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>